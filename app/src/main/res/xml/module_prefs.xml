<?xml version="1.0" encoding="utf-8"?>
<!--
    module_prefs.xml - Definisi SharedPreferences untuk DualLineStatusBar
    File ini mendefinisikan preferensi yang disimpan oleh modul
    Key-key ini digunakan oleh hook untuk membaca pengaturan user
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Pengaturan utama: aktifkan/nonaktifkan dual line -->
    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="pref_dual_line_enabled"
        android:summary="Aktifkan tampilan status bar dua baris"
        android:title="Aktifkan Dual Line" />

    <!-- Pengaturan tampilan tanggal di baris kedua -->
    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:dependency="pref_dual_line_enabled"
        android:key="pref_show_date"
        android:summary="Tampilkan tanggal di baris pertama bersama jam"
        android:title="Tampilkan Tanggal" />

    <!-- Pengaturan tampilan kecepatan jaringan -->
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:dependency="pref_dual_line_enabled"
        android:key="pref_show_network_speed"
        android:summary="Tampilkan kecepatan upload/download di status bar"
        android:title="Tampilkan Kecepatan Jaringan" />

    <!-- Kategori: Format Waktu -->
    <PreferenceCategory android:title="Format Tampilan">

        <!-- Format jam: 12 atau 24 jam -->
        <ListPreference
            android:defaultValue="HH:mm"
            android:dependency="pref_dual_line_enabled"
            android:entries="@array/time_format_entries"
            android:entryValues="@array/time_format_values"
            android:key="pref_time_format"
            android:summary="Format jam yang ditampilkan"
            android:title="Format Jam" />

        <!-- Format tanggal -->
        <ListPreference
            android:defaultValue="EEE, dd MMM"
            android:dependency="pref_show_date"
            android:entries="@array/date_format_entries"
            android:entryValues="@array/date_format_values"
            android:key="pref_date_format"
            android:summary="Format tanggal yang ditampilkan"
            android:title="Format Tanggal" />

    </PreferenceCategory>

</PreferenceScreen>
